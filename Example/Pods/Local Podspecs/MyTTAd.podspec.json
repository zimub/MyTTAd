    "tag": "1.0.9"
  },
  "platforms": {
    "ios": "12.0"
  },
  "swift_versions": [
    "5.0",
    "6.0"
  ],
  "vendored_frameworks": "MyTTAd.xcframework",
  "static_framework": true,
  "frameworks": [
